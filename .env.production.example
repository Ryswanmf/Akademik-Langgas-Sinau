# ==============================================================================
# KONFIGURASI ENVIRONMENT PRODUKSI - AKADEMI LANGGAS SINAU (cPanel / Hosting)
# ==============================================================================
# Petunjuk: Salin isi berkas ini ke berkas .env di root hosting cPanel Anda.

APP_NAME="Langgas Sinau Akademi"
APP_ENV=production
APP_KEY=base64:FWiAtJFlDVPJdRoqJUoXC2SrijHr1WQZgjZn/P7UP9c=
APP_DEBUG=false
APP_URL=https://nama-domain-anda.com
APP_FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Konfigurasi LKP Langgas Sinau
LKP_NAME="LKP Langgas Sinau Akademi"
LKP_ADDRESS="Banjar Rejo, Kec. Batanghari, Kabupaten Lampung Timur, Lampung"
LKP_LATITUDE=-5.124188
LKP_LONGITUDE=105.332312
LKP_RADIUS_METERS=150

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# DATABASE MYSQL cPANEL
# ------------------------------------------------------------------------------
# Sesuaikan nama database, username, dan password sesuai yang Anda buat di cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usernamecpanel_langgas
DB_USERNAME=usernamecpanel_userlanggas
DB_PASSWORD="PasswordDatabaseAnda123!"

# ------------------------------------------------------------------------------
# SESSION, CACHE & QUEUE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# EMAIL PEMBERITAHUAN (OPSIONAL - BISA MENGGUNAKAN SMTP CPANEL)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.nama-domain-anda.com
MAIL_PORT=465
MAIL_USERNAME=info@nama-domain-anda.com
MAIL_PASSWORD="PasswordEmailcPanelAnda"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@nama-domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
